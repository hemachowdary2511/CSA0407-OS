#include <stdio.h>
#include <string.h>

#define MAX_USERS 10
#define MAX_FILES 10
#define SIZE 50

struct User {
    char username[SIZE];
    char files[MAX_FILES][SIZE];
    int fileCount;
};

int main() {
    struct User users[MAX_USERS];
    int userCount = 0;
    int choice;
    char username[SIZE], filename[SIZE];
    int i, j, userIndex;

    while (1) {
        printf("\n--- Two-Level Directory ---\n");
        printf("1. Create User\n");
        printf("2. Create File\n");
        printf("3. Delete File\n");
        printf("4. Search File\n");
        printf("5. Display Directory\n");
        printf("6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

        case 1:
            if (userCount >= MAX_USERS) {
                printf("Maximum number of users reached!\n");
                break;
            }

            printf("Enter username: ");
            scanf("%s", username);

            // Check if user already exists
            userIndex = -1;
            for (i = 0; i < userCount; i++) {
                if (strcmp(users[i].username, username) == 0) {
                    userIndex = i;
                    break;
                }
            }

            if (userIndex != -1) {
                printf("User already exists!\n");
            } else {
                strcpy(users[userCount].username, username);
                users[userCount].fileCount = 0;
                userCount++;
                printf("User created successfully.\n");
            }
            break;

        case 2:
            printf("Enter username: ");
            scanf("%s", username);

            userIndex = -1;

            for (i = 0; i < userCount; i++) {
                if (strcmp(users[i].username, username) == 0) {
                    userIndex = i;
                    break;
                }
            }

            if (userIndex == -1) {
                printf("User not found!\n");
                break;
            }

            if (users[userIndex].fileCount >= MAX_FILES) {
                printf("Directory is full!\n");
                break;
            }

            printf("Enter file name: ");
            scanf("%s", filename);

            // Check if file already exists
            int exists = 0;

            for (i = 0; i < users[userIndex].fileCount; i++) {
                if (strcmp(users[userIndex].files[i], filename) == 0) {
                    exists = 1;
                    break;
                }
            }

            if (exists) {
                printf("File already exists!\n");
            } else {
                strcpy(users[userIndex].files[
                    users[userIndex].fileCount
                ], filename);

                users[userIndex].fileCount++;
                printf("File created successfully.\n");
            }
            break;

        case 3:
            printf("Enter username: ");
            scanf("%s", username);

            userIndex = -1;

            for (i = 0; i < userCount; i++) {
                if (strcmp(users[i].username, username) == 0) {
                    userIndex = i;
                    break;
                }
            }

            if (userIndex == -1) {
                printf("User not found!\n");
                break;
            }

            printf("Enter file name to delete: ");
            scanf("%s", filename);

            j = -1;

            for (i = 0; i < users[userIndex].fileCount; i++) {
                if (strcmp(users[userIndex].files[i], filename) == 0) {
                    j = i;
                    break;
                }
            }

            if (j == -1) {
                printf("File not found!\n");
            } else {
                for (i = j; i < users[userIndex].fileCount - 1; i++) {
                    strcpy(
                        users[userIndex].files[i],
                        users[userIndex].files[i + 1]
                    );
                }

                users[userIndex].fileCount--;
                printf("File deleted successfully.\n");
            }
            break;

        case 4:
            printf("Enter username: ");
            scanf("%s", username);

            userIndex = -1;

            for (i = 0; i < userCount; i++) {
                if (strcmp(users[i].username, username) == 0) {
                    userIndex = i;
                    break;
                }
            }

            if (userIndex == -1) {
                printf("User not found!\n");
                break;
            }

            printf("Enter file name to search: ");
            scanf("%s", filename);

            int found = 0;

            for (i = 0; i < users[userIndex].fileCount; i++) {
                if (strcmp(users[userIndex].files[i], filename) == 0) {
                    found = 1;
                    break;
                }
            }

            if (found)
                printf("File found.\n");
            else
                printf("File not found.\n");

            break;

        case 5:
            if (userCount == 0) {
                printf("No users found.\n");
            } else {
                printf("\nTwo-Level Directory Structure:\n");

                for (i = 0; i < userCount; i++) {
                    printf("\nUser: %s\n", users[i].username);

                    if (users[i].fileCount == 0) {
                        printf("  No files\n");
                    } else {
                        for (j = 0; j < users[i].fileCount; j++) {
                            printf("  %d. %s\n",
                                   j + 1,
                                   users[i].files[j]);
                        }
                    }
                }
            }
            break;

        case 6:
            printf("Exiting program...\n");
            return 0;

        default:
            printf("Invalid choice!\n");
        }
    }

    return 0;
}
